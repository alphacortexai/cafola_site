rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          "alphacortexai@gmail.com"
        ];
    }

    function validContact() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'firstName',
          'lastName',
          'email',
          'phone',
          'message',
          'source',
          'createdAt'
        ])
        && data.firstName is string
        && data.firstName.size() > 0
        && data.firstName.size() < 80
        && data.lastName is string
        && data.lastName.size() < 80
        && data.email is string
        && data.email.matches('.*@.*\\..*')
        && data.email.size() < 160
        && data.phone is string
        && data.phone.size() < 40
        && data.message is string
        && data.message.size() < 4000
        && data.source is string
        && data.source.size() < 80
        && data.createdAt is string
        && data.createdAt.size() < 40;
    }

    match /cms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactSubmissions/{docId} {
      allow create: if validContact();
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
